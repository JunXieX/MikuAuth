<?xml version="1.0" encoding="UTF-8"?>
<!--
  MikuAuth-Paper —— MikuAuth 的 Paper 服务端版本（与代理端共用一个仓库，但独立构件）。

  版本号与代理端保持同一条版本线：同一次发版里两个构件版本一致，
  便于服主确认"这对 jar 是一起发布的"（两者表结构也是共用的）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.miku</groupId>
    <artifactId>mikuauth-paper</artifactId>
    <version>3.8.3</version>
    <packaging>jar</packaging>
    <name>MikuAuth-Paper</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <!-- Paper 26.3 编译线；api-version 在 paper-plugin.yml 里填 26.2（低一档，避免旧端拒绝加载） -->
        <paper.version>26.3.build.206-stable</paper.version>
        <adventure.version>5.2.0</adventure.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API：编译期依赖，运行期由服务端提供 -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- MiniMessage：文本渲染。paper-api 会以 provided 传递 adventure-api，
             但 minimessage 不保证，因此显式声明并由 loader 提供运行时实现 -->
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-minimessage</artifactId>
            <version>${adventure.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- adventure-nbt：DialogAction.customClick 的 payload 需要 BinaryTagHolder。
             它不在 paper-api 的传递依赖里，必须显式声明（provided，运行期 Paper 自带） -->
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-nbt</artifactId>
            <version>${adventure.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- BCrypt：密码哈希。不 shade，运行时由 MikuAuthLoader 用 MavenLibraryResolver 下载 -->
        <dependency>
            <groupId>at.favre.lib</groupId>
            <artifactId>bcrypt</artifactId>
            <version>0.10.2</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>at.favre.lib</groupId>
            <artifactId>bytes</artifactId>
            <version>1.5.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- SQLite 驱动：同样由 loader 提供运行时实现 -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>MikuAuth-Paper-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>paper-plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>paper-plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>25</release>
                    <!-- 与代理端一致：JDK 25 上进程内编译会触发 javac 内部缺陷，固定 fork 绕过 -->
                    <fork>true</fork>
                    <compilerArgs>
                        <arg>-g:lines,source</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
        </plugins>
    </build>
</project>
